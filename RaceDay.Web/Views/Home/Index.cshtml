@{
    ViewData["Title"] = "Welcome";
}
<section class="rd-hero">
    <div class="rd-hero-inner">
        <h1>RUN IT.<br />TRACK IT.<br /><span>OWN IT.</span></h1>
        <p class="lead">RaceDay brings running events, enrolments and results together in one place.</p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-lg rd-btn" asp-controller="Account" asp-action="Register">Join RaceDay</a>
            <a class="btn btn-lg btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </div>
</section>

<div class="row g-4 mt-1">
    <div class="col-md-4">
        <div class="rd-panel h-100">
            <h3 class="rd-heading">For organisers</h3>
            <p>Create events, add distance or age categories, upload a banner, see who has enrolled and publish the results.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-panel h-100">
            <h3 class="rd-heading">For participants</h3>
            <p>Find upcoming events, enrol in the category that suits you and follow your enrolment status.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="rd-panel h-100">
            <h3 class="rd-heading">Your race history</h3>
            <p>See every finish time and your position, for example 47th out of 312 finishers.</p>
        </div>
    </div>
</div>
