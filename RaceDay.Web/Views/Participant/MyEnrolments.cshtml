@model List<MyEnrolment>
@{
    ViewData["Title"] = "My enrolments";
}
<h1 class="rd-heading">My enrolments</h1>

@if (Model.Count == 0)
{
    <div class="rd-panel text-center py-5">
        <h3 class="rd-heading">You have not enrolled in an event yet</h3>
        <a class="btn rd-btn" asp-controller="Events" asp-action="Index">Find an event</a>
    </div>
}
else
{
    <div class="rd-panel">
        <div class="table-responsive">
            <table class="table align-middle rd-table">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th>Enrolled on</th><th class="text-end">Action</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId"><strong>@item.EventTitle</strong></a><br />
                            <span class="rd-meta">@item.Location</span>
                        </td>
                        <td>@Formatters.DateText(item.EventDate)</td>
                        <td>@item.CategoryName</td>
                        <td><partial name="_StatusBadge" model="item.Status" /></td>
                        <td>@Formatters.DateText(item.EnrolmentDate)</td>
                        <td class="text-end">
                            @if (item.HasResult)
                            {
                                <span class="rd-meta">Result published</span>
                            }
                            else
                            {
                                <form asp-controller="Participant" asp-action="CancelEnrolment" method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel this enrolment?');">
                                    <input type="hidden" name="id" value="@item.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
