@model List<MyResult>
@{
    ViewData["Title"] = "My results";
}
<h1 class="rd-heading">My results</h1>

@if (Model.Count == 0)
{
    <div class="rd-panel text-center py-5">
        <h3 class="rd-heading">No results yet</h3>
        <p class="mb-0">Your results appear here after an organiser publishes them.</p>
    </div>
}
else
{
    <div class="rd-panel">
        <div class="table-responsive">
            <table class="table align-middle rd-table">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.EventTitle</strong></td>
                        <td>@Formatters.DateText(item.EventDate)</td>
                        <td>@item.CategoryName</td>
                        <td class="rd-time">@Formatters.Duration(item.FinishTime)</td>
                        <td><span class="rd-position">@Formatters.PositionText(item.Position, item.TotalFinishers)</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
