@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<a asp-action="Categories" asp-route-eventId="@Model.EventId" class="rd-back">&larr; Back to categories</a>

<div class="row justify-content-center mt-2">
    <div class="col-lg-6">
        <div class="rd-panel">
            <h1 class="rd-heading">Edit category</h1>
            @if (ViewBag.EventTitle != null)
            {
                <p class="rd-meta">@ViewBag.EventTitle</p>
            }
            <form asp-controller="Organiser" asp-action="EditCategory" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="CategoryId" />

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label"></label>
                    <input asp-for="CategoryName" class="form-control" maxlength="100" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn rd-btn">Save changes</button>
                <a asp-action="Categories" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
