@model EventFormViewModel
@{
    var isNew = Model.EventId == 0;
    ViewData["Title"] = isNew ? "Create event" : "Edit event";
}
<a asp-action="Events" class="rd-back">&larr; My events</a>

<div class="row justify-content-center mt-2">
    <div class="col-lg-8">
        <div class="rd-panel">
            <h1 class="rd-heading">@(isNew ? "Create a new event" : "Edit event")</h1>

            <form asp-controller="Organiser" asp-action="@(isNew ? "CreateEvent" : "EditEvent")" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="HasBanner" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" maxlength="150" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" maxlength="150" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(EventTypes.WithCurrent(Model.EventType)))"></select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (Model.HasBanner)
                    {
                        <div class="mb-2">
                            <img class="rd-banner-preview" src="@Url.Action("Event", "Images", new { id = Model.EventId })" alt="Current banner" />
                            <div class="rd-meta">Choose a new image below to replace this banner.</div>
                        </div>
                    }
                    <input asp-for="Banner" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                    <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB.</div>
                </div>

                <button type="submit" class="btn rd-btn">@(isNew ? "Create event" : "Save changes")</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
